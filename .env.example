VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Datos de ejemplo del rediseño (partidos, tablas, actividad). Por defecto: activos en `npm run dev`,
# desactivados en cualquier build. Usa true solo en entornos de demo; nunca en producción.
# VITE_PREVIEW_DATA=false
# Hosts de App Links (separados por comas) que el wrapper Android abre como /j/:code y /p/:poolId.
# Deben coincidir con los intent-filter de AndroidManifest.xml. Sin valor: sportleagues-qa.vercel.app.
# VITE_APP_LINK_HOSTS=sportleagues-qa.vercel.app
# Correo de contacto de privacidad mostrado en /privacidad y /terminos. Obligatorio antes de una publicación abierta.
# VITE_LEGAL_CONTACT_EMAIL=
